<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingTop="8dp" android:paddingBottom="8dp" android:clipChildren="false" android:clipToPadding="false">
    <FrameLayout android:id="@+id/btnLibrary" android:layout_width="180dp" android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top" android:background="@drawable/tile_bg"
        android:focusable="true" android:clickable="true" android:contentDescription="@string/app_library"
        android:stateListAnimator="@animator/focus_lift">
        <ImageView android:id="@+id/icon" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center"
            android:src="@drawable/ic_more" android:contentDescription="@null" />
    </FrameLayout>
    <TextView android:id="@+id/name" android:layout_width="180dp" android:layout_height="22dp"
        android:layout_gravity="center_horizontal|top" android:layout_marginTop="108dp" android:gravity="center"
        android:includeFontPadding="false" android:text="@string/app_library" android:textColor="#F2FFFFFF"
        android:textSize="14sp" android:fontFamily="@string/font_medium" />
</FrameLayout>
