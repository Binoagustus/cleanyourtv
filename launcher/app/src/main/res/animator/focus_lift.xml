<?xml version="1.0" encoding="utf-8"?>
<!-- Selected: grows 12% with a soft overshoot, so focus on a pill or card is plain to see from the sofa. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.12" android:duration="220"
                android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.12" android:duration="220"
                android:interpolator="@android:interpolator/overshoot" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="160" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="160" />
        </set>
    </item>
</selector>
